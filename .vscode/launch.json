{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MadBeauty (avec .env)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/.env"]
    },
    {
      "name": "MadBeauty (sans .env)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "MadBeauty Web (Chrome + .env)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port=7357",
        "--dart-define-from-file=${workspaceFolder}/.env"
      ]
    }
  ]
}
