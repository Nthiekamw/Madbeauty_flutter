SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# URLs HTTPS pour Stripe Connect (ne pas utiliser com.madbeauty:// ici).
# Par défaut : https://VOTRE_PROJECT.supabase.co/functions/v1/stripe_connect_redirect?to=return|refresh
# STRIPE_CONNECT_RETURN_URL=https://xxxx.supabase.co/functions/v1/stripe_connect_redirect?to=return
# STRIPE_CONNECT_REFRESH_URL=https://xxxx.supabase.co/functions/v1/stripe_connect_redirect?to=refresh
SUPABASE_EMAIL_REDIRECT_URL=com.madbeauty.madbeauty://login-callback
# Partage fiche prestataire (build --dart-define-from-file=.env)
# Vide = lien HTTPS Supabase auto (sans site) → redirige vers l'app
# custom = com.madbeauty.madbeauty://prestataire/{id} uniquement
# https://app.com = futur site → https://app.com/prestataire/{id}
# SHARE_BASE_URL=custom
