SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_EMAIL_REDIRECT_URL=com.madbeauty.madbeauty://login-callback
# Flutter Web — Google OAuth (Supabase → Auth → URL Configuration) :
#   Redirect URLs (ajouter toutes) :
#     http://localhost:7357
#     https://madbeauty.pro
#     https://madbeauty-app.netlify.app   (ancien, optionnel)
#     com.madbeauty.madbeauty://login-callback   (mobile)
#   Site URL recommandé en prod web : https://madbeauty.pro
#   (si Site URL = deep link mobile, OAuth web échoue avec « scheme does not have a registered handler »)
# Dev local uniquement — le deploy Netlify force https://madbeauty.pro
SUPABASE_WEB_REDIRECT_URL=http://localhost:7357
# Stripe (Flutter Web uniquement pour l’instant — clé publique live ou test)
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Web Push FCM — Firebase Console → Cloud Messaging → Certificats Web Push → Paire de clés
# Coller la clé publique (VAPID) ; même valeur dans les secrets Netlify / CI pour le build web.
FIREBASE_WEB_VAPID_KEY=BNxxxxxxxx...
# NETLIFY_APP_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Admin web (dossier web-admin/) — génère web-admin/admin/config.js :
# powershell -File scripts/sync_web_admin_config.ps1
# App Flutter Web Netlify :
#   1. Site Netlify (madbeauty-app) + domaine custom https://madbeauty.pro
#   2. Supabase → Redirect URLs : https://madbeauty.pro (+ Site URL)
#   3. GitHub secrets : SUPABASE_WEB_REDIRECT_URL=https://madbeauty.pro, SHARE_BASE_URL=https://madbeauty.pro
#   4. Déploiement local : powershell -File scripts/deploy_app_netlify.ps1
# Partage fiche prestataire (build --dart-define-from-file=.env)
# Vide = lien HTTPS Supabase auto (sans site) → redirige vers l'app
# custom = com.madbeauty.madbeauty://prestataire/{id} uniquement
# https://madbeauty.pro = prod → https://madbeauty.pro/prestataire/{id}
# SHARE_BASE_URL=https://madbeauty.pro
# Site vitrine (dossier website/) — site Netlify madbeauty-web :
#   NETLIFY_WEBSITE_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   powershell -File scripts/deploy_website_netlify.ps1
#   (ou CI : workflow deploy-website-netlify.yml)
# URL attendue : https://madbeauty-web.netlify.app
# WEBSITE_BASE_URL=https://madbeauty-web.netlify.app
# Politique de confidentialité (App Store Connect + lien in-app)
# PRIVACY_POLICY_URL=https://madbeauty-web.netlify.app/privacy.html
# CHILD_SAFETY_URL=https://madbeauty-web.netlify.app/child-safety.html
