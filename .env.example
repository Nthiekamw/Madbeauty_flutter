SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_EMAIL_REDIRECT_URL=com.madbeauty.madbeauty://login-callback
# Flutter Web — Google OAuth (Supabase → Auth → URL Configuration) :
#   Redirect URLs (ajouter toutes) :
#     http://localhost:7357
#     https://madbeauty-app.netlify.app
#     com.madbeauty.madbeauty://login-callback   (mobile)
#   Site URL recommandé en prod web : https://madbeauty-app.netlify.app
#   (si Site URL = deep link mobile, OAuth web échoue avec « scheme does not have a registered handler »)
# Dev local uniquement — le deploy Netlify force https://madbeauty-app.netlify.app
SUPABASE_WEB_REDIRECT_URL=http://localhost:7357
# NETLIFY_APP_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Admin web (dossier web-admin/) — génère web-admin/admin/config.js :
# powershell -File scripts/sync_web_admin_config.ps1
# App Flutter Web Netlify :
#   1. Créer un site Netlify (ex. madbeauty-app) → copier l'ID dans NETLIFY_APP_SITE_ID
#   2. Supabase → Redirect URLs : https://<ton-site>.netlify.app
#   3. GitHub secrets : NETLIFY_APP_SITE_ID, SUPABASE_WEB_REDIRECT_URL (même URL)
#   4. Déploiement local : powershell -File scripts/deploy_app_netlify.ps1
# Partage fiche prestataire (build --dart-define-from-file=.env)
# Vide = lien HTTPS Supabase auto (sans site) → redirige vers l'app
# custom = com.madbeauty.madbeauty://prestataire/{id} uniquement
# https://app.com = futur site → https://app.com/prestataire/{id}
# SHARE_BASE_URL=custom
# Politique de confidentialité (App Store Connect + lien in-app)
# PRIVACY_POLICY_URL=https://madbeauty-app.netlify.app/privacy.html
